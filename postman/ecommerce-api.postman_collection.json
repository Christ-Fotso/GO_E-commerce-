              "raw": "{\n  \"username\": \"bob\",\n  \"email\": \"bob@test.fr\",\n  \"password\": \"bobbob\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
