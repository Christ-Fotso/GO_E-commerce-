    {
      "name": "3. Panier",
      "item": [
        {
          "name": "Voir le panier",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            }
          }
        },
        {
          "name": "Ajouter 2 claviers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
