                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/items/4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "items",
                "4"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
